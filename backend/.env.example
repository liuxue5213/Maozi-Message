# 生产环境必须设置为至少 32 字节的随机值，且不要提交真实 .env 文件。
TOKEN_SECRET=replace-with-a-long-random-secret

# 多个来源以英文逗号分隔；不设置时允许所有来源，适合本地开发。
# CORS_ORIGINS=https://your-domain.example

# PORT=60175

# 展示时区偏移（小时），"今日留言"按此时区计算；默认 8（东八区）。
# DISPLAY_TZ_OFFSET=8

# 自定义敏感词库路径；默认使用 backend/banned-words.txt。
# BANNED_WORDS_FILE=/path/to/banned-words.txt
